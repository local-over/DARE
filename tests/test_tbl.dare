@setup {
  format: A4;
}

@doc {
  page {
    box(p=10mm) {
      txt(size=16, bold) { Table Tests }
      sp(h=10) {}
      
      txt(size=12, bold) { 1. Simple Auto Table }
      tbl {
        Header 1, Header 2, Header 3;
        Row 1 Col 1, Row 1 Col 2, Row 1 Col 3;
        Row 2 Col 1, Row 2 Col 2, Row 2 Col 3
      }
      
      sp(h=15) {}
      
      txt(size=12, bold) { 2. Fraction Columns Table }
      tbl(cols="2fr 1fr 1fr") {
        Description, Quantity, Price;
        Product A, 2, $50;
        Product B, 5, $15;
        Service Fee, 1, $100
      }
    }
  }
}
