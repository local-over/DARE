@setup {
  format: A4;
  $accent: color=#0ea5e9;
  $gray: color=#64748b;
  $section: size=12 bold color=#0f172a uppercase ls=1 mb=1mm mt=1mm;
  $body: size=10 color=#334155 lh=1.3;
  $label: size=9 bold color=#0f172a;
  $sm: size=8 color=#94a3b8;
  $badge: bg=#f1f5f9 color=#0f172a;
}

@doc {
  page {
    box(bg=#0f172a, p=5mm) {
      cols(between) {
        box(w=60%) {
          txt(size=24, bold, color=white) { HASSAN ELKADY }
          txt(size=10, color=#94a3b8) { Software Engineer }
        }
        box(w=40%, ta=right) {
          txt(size=8, color=white) { hassan@example.com }
          txt(size=8, color=white) { +20 123 456 7890 }
          txt(size=8, color=white) { github.com/local-over }
        }
      }
    }

    box(px=10mm, py=2mm) {
      txt($section) { Profile }
      hr {}
      sp(h=1mm) {}
      txt($body) {
        Senior software engineer with 5+ years building scalable web applications and AI-powered tools. Creator of DARE Engine — an AI-native PDF generation system. Passionate about developer tooling and open source.
      }

      txt($section) { Skills }
      hr {}
      sp(h=1mm) {}
      cols(n=4) {
        box { badge($badge) { JavaScript / TS } }
        box { badge($badge) { Node.js / Express } }
        box { badge($badge) { React / Next.js } }
        box { badge($badge) { Python / FastAPI } }
      }
      sp(h=1mm) {}
      cols(n=4) {
        box { badge($badge) { PostgreSQL / Redis } }
        box { badge($badge) { Docker / CI-CD } }
        box { badge($badge) { Sys Architecture } }
        box { badge($badge) { System Design } }
      }

      txt($section) { Experience }
      hr {}
      sp(h=1mm) {}

      box(mb=3mm) {
        cols(between) {
          box(w=50%) { txt($label) { Senior Software Engineer } }
          box(w=50%, ta=right) { txt($sm) { 2023 — Present } }
        }
        txt($accent, size=9) { TechCorp Inc. }
        txt($body) { Led development of microservices platform serving 2M+ users. Designed event-driven architecture reducing latency by 40%. }
      }

      box(mb=3mm) {
        cols(between) {
          box(w=50%) { txt($label) { Full Stack Developer } }
          box(w=50%, ta=right) { txt($sm) { 2021 — 2023 } }
        }
        txt($accent, size=9) { StartupXYZ }
        txt($body) { Built real-time collaboration platform from scratch. Implemented WebSocket infrastructure and React frontend. }
      }

      box(mb=3mm) {
        cols(between) {
          box(w=50%) { txt($label) { Junior Developer } }
          box(w=50%, ta=right) { txt($sm) { 2020 — 2021 } }
        }
        txt($accent, size=9) { Agency Co. }
        txt($body) { Developed client websites and e-commerce solutions using modern JavaScript stack. }
      }

      txt($section) { Education }
      hr {}
      sp(h=1mm) {}
      cols(between) {
        box(w=50%) { txt($label) { B.Sc. Computer Science } }
        box(w=50%, ta=right) { txt($sm) { 2016 — 2020 } }
      }
      txt($accent, size=9) { Cairo University }
    }
  }
}
