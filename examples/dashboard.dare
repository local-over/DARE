@setup {
  format: A4;
  $brand: color=#7c3aed;
  $card: bg=white border=1 rounded=3 p=6mm shadow="0 2px 8px rgba(0,0,0,0.06)";
  $h1: size=22 bold color=#0f172a;
  $h2: size=13 bold color=#334155 mb=2mm;
  $p: size=10 color=#475569 lh=1.3;
  $sm: size=8 color=#94a3b8;
  $ok: color=#16a34a;
  $warn: color=#f59e0b;
  $bad: color=#dc2626;
}

@doc {

  // PAGE 1: Dashboard Overview
  page {
    box(h=20mm, bg=#7c3aed, px=12mm, py=6mm) {
      cols(between) {
        box(w=50%) { txt(bold, color=white, size=14) { QUARTERLY REPORT } }
        box(w=50%, ta=right) { txt(color=white, size=10) { Q4 2025 } }
      }
    }

    box(p=10mm) {
      txt($h1) { Revenue Dashboard }
      sp(h=4mm) {}

      // KPI Cards
      cols(n=4, gap=5mm) {
        box($card, col, align=center) {
          txt($sm) { REVENUE }
          sp(h=1mm) {}
          txt(size=20, bold, $brand) { $2.4M }
          sp(h=1mm) {}
          txt(size=9, $ok) { +18% }
        }
        box($card, col, align=center) {
          txt($sm) { CUSTOMERS }
          sp(h=1mm) {}
          txt(size=20, bold) { 12,847 }
          sp(h=1mm) {}
          txt(size=9, $ok) { +24% }
        }
        box($card, col, align=center) {
          txt($sm) { CHURN }
          sp(h=1mm) {}
          txt(size=20, bold) { 3.2% }
          sp(h=1mm) {}
          txt(size=9, $bad) { +0.5% }
        }
        box($card, col, align=center) {
          txt($sm) { NPS SCORE }
          sp(h=1mm) {}
          txt(size=20, bold) { 72 }
          sp(h=1mm) {}
          txt(size=9, $warn) { -2pts }
        }
      }

      sp(h=5mm) {}

      // Charts Row
      cols(n=2, gap=8mm) {
        box($card) {
          txt($h2) { Revenue by Quarter }
          bar(labels="Q1,Q2,Q3,Q4" data="1.2,1.5,1.9,2.4" label="Revenue" h=45mm color=#7c3aed) {}
        }
        box($card) {
          txt($h2) { Revenue by Product }
          pie(labels="SaaS,Services,Licensing" data="55,25,20" h=45mm) {}
        }
      }

      sp(h=5mm) {}

      // Data Table
      box($card) {
        txt($h2) { Top Accounts }
        tbl(cols="2fr 1fr 1fr 1fr") {
          Account, Revenue, Growth, Status;
          Acme Corp, $340K, +22%, Active;
          TechStart Inc, $280K, +15%, Active;
          Global Systems, $195K, -3%, At Risk;
          DataFlow Ltd, $165K, +45%, Active;
          CloudNet, $120K, +8%, Active
        }
      }
    }

    ftr(h=10mm, bg=#f1f5f9, px=12mm, py=3mm) {
      cols(between) {
        box(w=50%) { txt($sm) { CONFIDENTIAL } }
        box(w=50%, ta=right) { txt($sm) { Page 1 of 2 } }
      }
    }
  }

  // PAGE 2: Detailed Analysis
  page {
    box(h=20mm, bg=#7c3aed, px=12mm, py=6mm) {
      cols(between) {
        box(w=50%) { txt(bold, color=white, size=14) { DETAILED ANALYSIS } }
        box(w=50%, ta=right) { txt(color=white, size=10) { Q4 2025 } }
      }
    }

    box(p=10mm) {

      txt($h1) { Channel Performance }
      sp(h=4mm) {}

      cols(n=2, gap=8mm) {
        box($card) {
          txt($h2) { Acquisition Channels }
          bar(labels="Organic,Paid,Referral,Social,Email" data="450,320,180,95,210" label="Acquisition" h=45mm color=#0ea5e9) {}
        }
        box($card) {
          txt($h2) { Customer Segments }
          pie(labels="Enterprise,Mid-Market,SMB" data="40,35,25" type=donut h=45mm) {}
        }
      }

      sp(h=6mm) {}

      txt($h2) { Key Insights }
      list {
        Organic search drove 42% of new signups, up 15% from Q3;
        Enterprise segment grew 28% with larger average deal size;
        Paid acquisition CPA decreased by 12% through channel optimization;
        Referral program launched in October contributing 180 new customers;
        Email campaigns achieved 4.2% conversion rate
      }

      sp(h=6mm) {}

      txt($h2) { Recommendations }
      cols(n=3, gap=5mm) {
        box($card) {
          txt(bold, size=10, $ok) { Double Down }
          sp(h=1mm) {}
          txt($p) { Increase organic content budget by 30%. Highest ROI channel. }
        }
        box($card) {
          txt(bold, size=10, $warn) { Optimize }
          sp(h=1mm) {}
          txt($p) { Refine paid targeting. Good volume but CPA still above target. }
        }
        box($card) {
          txt(bold, size=10, $bad) { Address }
          sp(h=1mm) {}
          txt($p) { Investigate churn increase. Schedule customer interviews. }
        }
      }
    }

    ftr(h=10mm, bg=#f1f5f9, px=12mm, py=3mm) {
      cols(between) {
        box(w=50%) { txt($sm) { CONFIDENTIAL } }
        box(w=50%, ta=right) { txt($sm) { Page 2 of 2 } }
      }
    }
  }
}
