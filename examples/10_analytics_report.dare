@setup {
  format: A4;
  $h1: size=20 bold color=#111827 mb=5mm;
  $stat: size=24 bold color=#4f46e5 ta=center;
  $lbl: size=10 color=#6b7280 ta=center;
}
@doc {
  page {
    box(p=10mm) {
      txt($h1) { Q3 Performance Report }
      hr() {}
      sp(h=3mm) {}
      
      cols(n=3, gap=5mm) {
        box(p=5mm, bg=#f3f4f6, border=1) {
          txt($stat) { 14.5M }
          txt($lbl) { Total Users }
        }
        box(p=5mm, bg=#f3f4f6, border=1) {
          txt($stat) { $2.4B }
          txt($lbl) { Revenue }
        }
        box(p=5mm, bg=#f3f4f6, border=1) {
          txt($stat) { +42% }
          txt($lbl) { YoY Growth }
        }
      }
      
      sp(h=5mm) {}
      
      cols(gap=10mm) {
        box(w=50%) {
          txt(bold, mb=2mm) { Traffic Sources }
          pie(labels="Organic,Direct,Paid,Social", data="45,25,20,10", w=250pt) {}
        }
        box(w=50%) {
          txt(bold, mb=2mm) { Monthly Revenue }
          bar(labels="July,August,Sept", data="700,850,920", label="Revenue (M)") {}
        }
      }
      
      sp(h=5mm) {}
      txt(bold, mb=3mm) { Top Performing Regions }
      tbl(cols="2fr 1fr 1fr 1fr") {
        Region, Users, Revenue, Growth;
        North America, 5.2M, $1.1B, +15%;
        Europe, 4.8M, $0.8B, +22%;
        Asia Pacific, 3.5M, $0.4B, +85%;
        Latin America, 1.0M, $0.1B, +120%
      }
      
      sp(h=5mm) {}
      txt(bold, mb=3mm) { Key Insights }
      list(type=ul, size=11) {
        Asia Pacific shows strongest growth trajectory at +85% YoY
        North America remains the largest revenue contributor at $1.1B
        Organic traffic dominates at 45% of total acquisition
        Q3 revenue exceeded projections by 12%
      }
    }
  }
}
