@setup {
  format: 90mm 55mm;
  $title: size=14 bold color=white;
  $sub: size=8 color=#cbd5e1;
  $contact: size=6 color=#94a3b8;
}
@doc {
  page(bg=#0f172a) {
    box(p=2mm) {
      cols(between) {
        box(w=60%) {
          txt($title) { JOHN DOE }
          txt($sub, mb=2mm) { Software Engineer }
          txt($contact) { +1 234 567 8900 }
          txt($contact) { john.doe@dare.engine }
        }
        box(w=40%) {
          qr(data="https://johndoe.com", w=15mm) {}
        }
      }
      cols(between, mt=2mm) {
        shape(type=triangle, w=10mm, h=10mm, bg=#c2410c) {}
        shape(type=circle, w=10mm, h=10mm, bg=#38bdf8) {}
      }
    }
  }
}
