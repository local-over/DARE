@setup {
  format: A4;
  $brand: color=#1e40af;
  $dark: bg=#0f172a color=white;
  $gray: color=#64748b;
  $card: bg=white border=1 rounded=2 p=5mm;
  $h1: size=28 bold;
  $h2: size=14 bold color=#334155 mb=2mm;
  $label: size=9 color=#94a3b8 uppercase;
  $val: size=11 color=#1e293b;
}

@doc {
  page {
    box(h=30mm, bg=#0f172a, px=15mm, py=8mm) {
      cols(between) {
        box(w=50%) {
          txt(size=24, bold, color=white) { INVOICE }
          txt(size=9, color=white, mt=1mm) { #INV-2025-0042 }
        }
        box(w=50%, ta=right) {
          txt(size=9, color=white) { Issue Date }
          txt(size=13, bold, color=white) { February 22, 2025 }
        }
      }
    }

    box(p=10mm) {
      cols(n=2, gap=20mm) {
        box(w=50%) {
          txt($label) { FROM }
          sp(h=1mm) {}
          txt($val, bold) { Hassan Elkady }
          txt($val) { Software Engineer }
          txt($gray, size=9) { Cairo, Egypt }
        }
        box(w=50%) {
          txt($label) { BILL TO }
          sp(h=1mm) {}
          txt($val, bold) { Acme Corporation }
          txt($val) { 123 Business Ave }
          txt($gray, size=9) { New York, NY 10001 }
        }
      }

      sp(h=4mm) {}

      txt($h2) { Services }
      tbl(cols="3fr 1fr 1fr 1fr") {
        Description, Qty, Rate, Amount;
        Website Redesign — Full responsive UI, 1, $2500, $2500;
        Backend API Development, 40hrs, $75/hr, $3000;
        Database Architecture, 20hrs, $85/hr, $1700;
        SEO Optimization, 1, $500, $500
      }

      sp(h=4mm) {}

      cols(between) {
        box(w=50%) {}
        box(w=50%) {
          cols(between) {
            box(w=50%) { txt($gray, size=10) { Subtotal } }
            box(w=50%, ta=right) { txt($val) { $7,700 } }
          }
          sp(h=1mm) {}
          cols(between) {
            box(w=50%) { txt($gray, size=10) { Tax (10%) } }
            box(w=50%, ta=right) { txt($val) { $770 } }
          }
          hr {}
          sp(h=1mm) {}
          cols(between) {
            box(w=50%) { txt(size=15, bold) { Total } }
            box(w=50%, ta=right) { txt(size=15, bold, $brand) { $8,470 } }
          }
        }
      }

      sp(h=4mm) {}

      box($card) {
        txt($h2) { Payment Details }
        sp(h=1mm) {}
        cols(n=2, gap=15mm) {
          box(w=50%) {
            txt($label) { Bank }
            sp(h=1mm) {}
            txt($val) { National Bank of Egypt }
          }
          box(w=50%) {
            txt($label) { Account }
            sp(h=1mm) {}
            txt($val) { 1234-5678-9012 }
          }
        }
      }
    }

    ftr(h=10mm, bg=#f8fafc, px=15mm, py=2mm) {
      cols(between) {
        box(w=50%) { txt(size=8, $gray) { Thank you for your business! } }
        box(w=50%, ta=right) { txt(size=8, $gray) { Page 1 of 1 } }
      }
    }
  }
}
