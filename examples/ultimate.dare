@setup {
  format: A4;
  $hdr: bg=#0f172a p=5mm;
  $hdrTxt: size=12 bold color=white;
  $hdrSub: size=10 color=#c2410c bold;
  $ftr: bg=#f1f5f9 p=3mm border=1;
  $ftrTxt: size=8 color=#94a3b8;
  $h1: size=28 bold color=#0f172a mb=5mm;
  $h2: size=16 bold color=#475569 mb=4mm uppercase;
  $h3: size=12 bold color=#0f172a mb=2mm;
  $p: size=10 color=#334155 mb=3mm;
  $mono: size=9 color=#64748b;
  $mars: color=#c2410c;
  $sectionBox: p=4mm bg=#f8fafc border=1 mb=4mm;
}

@doc {

  // PAGE 1: COVER
  page {
    box(bg=#020617, p=20mm) {
      sp(h=30mm) {}
      txt(size=14, color=#64748b, mb=5mm) { CLASSIFIED DOCUMENT }
      txt(size=48, bold, color=white) { PROJECT }
      txt(size=48, bold, color=#c2410c) { ARES }
      sp(h=5mm) {}
      hr(color=#334155) {}
      sp(h=5mm) {}
      txt(size=16, color=#94a3b8) { TERRAFORMING INITIATIVE }
      txt(size=12, color=#64748b) { MASTER PLAN v12.0 }
      sp(h=30mm) {}
      txt(size=10, bold, color=white) { AUTHORIZED BY }
      txt(size=14, bold, color=#c2410c) { HASSAN ELKADY }
      txt(size=10, color=#94a3b8) { github.com/local-over }
      sp(h=10mm) {}
      txt(size=8, color=#334155) { Generated by DARE Engine v12.0 }
    }
  }

  // PAGE 2: LEGAL & TOC
  page {
    hdr() {
      box($hdr) {
        cols(between) {
          txt($hdrTxt) { LEGAL }
          txt($hdrSub) { CONFIDENTIAL }
        }
      }
    }
    ftr() {
      box($ftr) {
        cols(between) {
          txt($ftrTxt) { ARES-DOC-001 }
          txt($ftrTxt) { Page {{page}} of {{pages}} }
        }
      }
    }
    box(p=10mm) {
      txt($h2) { 1. Non-Disclosure Agreement }
      txt($p) { This document contains classified schematics regarding the ARES Life Support System. Unauthorized distribution is punishable by interplanetary law (Article 7, Section 9). By reading past this page, you agree to the terms set forth by the Mars Colonial Administration. }

      txt($h2, mt=8mm) { 2. Table of Contents }
      tbl(cols="1fr 4fr 1fr") {
        PG, SECTION, STATUS;
        01, Cover, Public;
        02, Legal & Table of Contents, Public;
        03, Mission Overview, Public;
        04, Atmospheric Data, Classified;
        05, Energy Grid, Classified;
        06, Blueprint: Hab Module, Secret;
        07-08, Supply Manifest, Secret;
        09, Personnel Roster, Restricted;
        10, Risk Assessment, Class A;
        11, Incident Logs, Internal;
        12, Final Approval, Signed
      }

      sp(h=15mm) {}
      hr(color=#cbd5e1) {}
      sp(h=3mm) {}
      txt(size=8, color=#666) { DIGITAL SIGNATURE VALIDATED: HASSAN-KEY-99283 }
    }
  }

  // PAGE 3: MISSION OVERVIEW
  page {
    box(p=10mm) {
      txt($h1) { MISSION GOALS }
      sp(h=3mm) {}

      cols(n=2, gap=5mm) {
        box($sectionBox) {
          txt($h3) { PHASE 1: DEPLOYMENT }
          txt($p) { Establish a stable landing zone in the Cydonia region. Deploy autonomous rovers for soil analysis. }
          cols(between) {
            txt(size=9, color=#16a34a, bold) { Progress: 100% }
            txt(size=9, color=#16a34a, bold) { Risk: Low }
          }
        }
        box($sectionBox) {
          txt($h3) { PHASE 2: HABITATION }
          txt($p) { Construct pressurized domes. Activate oxygen scrubbers. Begin hydroponic farming. }
          cols(between) {
            txt(size=9, color=#0891b2, bold) { Progress: 65% }
            txt(size=9, color=#eab308, bold) { Risk: Medium }
          }
        }
      }
      sp(h=3mm) {}
      cols(n=2, gap=5mm) {
        box($sectionBox) {
          txt($h3) { PHASE 3: INDUSTRY }
          txt($p) { Begin mining operations for water ice and iron. Establish fuel refinery. }
          cols(between) {
            txt(size=9, color=#c2410c, bold) { Progress: 15% }
            txt(size=9, color=#dc2626, bold) { Risk: High }
          }
        }
        box($sectionBox) {
          txt($h3) { PHASE 4: TERRAFORMING }
          txt($p) { Release atmospheric thickeners. Raise global temperature by 5 degrees Celsius. }
          cols(between) {
            txt(size=9, color=#94a3b8, bold) { Progress: 0% }
            txt(size=9, color=#dc2626, bold) { Risk: Extreme }
          }
        }
      }

      sp(h=5mm) {}
      txt($h2) { Mission Timeline }
      bar(labels="Deployment,Habitation,Industry,Terraforming", data="100,65,15,0", label="Completion %") {}
    }
  }

  // PAGE 4: ATMOSPHERIC DATA
  page {
    box(p=10mm) {
      txt($h2) { Surface Conditions }

      txt(bold, mb=3mm) { Gas Composition (ppm) }
      bar(labels="CO2,Nitrogen,Argon,Oxygen,Water", data="950,27,16,1,0.3", label="Concentration") {}

      sp(h=5mm) {}
      cols(n=2, gap=8mm) {
        box(p=5mm, bg=#fef2f2, border=1) {
          txt(size=9, color=#6b7280) { Avg Temperature }
          txt(size=32, bold, color=#dc2626) { -60 C }
          txt(size=10, color=#dc2626) { Critical Low }
        }
        box(p=5mm, bg=#fffbeb, border=1) {
          txt(size=9, color=#6b7280) { Radiation Levels }
          txt(size=32, bold, color=#c2410c) { 240 }
          txt(size=10, color=#c2410c) { mSv/Year }
        }
      }

      sp(h=5mm) {}
      txt($h2) { Atmospheric Pressure }
      txt($p) { Current surface pressure averages 610 Pa (0.6% of Earth). Dome pressure maintained at 101.3 kPa via pressurization system. All habitable zones maintain Earth-standard atmosphere. }
    }
  }

  // PAGE 5: ENERGY GRID
  page {
    box(p=10mm) {
      txt($h2) { Reactor Output }

      txt(bold, mb=3mm) { Fusion Core Efficiency (%) }
      bar(labels="Core A,Core B,Core C,Backup", data="98,96,45,100", label="Efficiency %") {}

      sp(h=3mm) {}
      box(p=4mm, bg=#fef2f2, border=1, mb=5mm) {
        txt(size=10, color=#dc2626, bold) { WARNING: Core C showing signs of thermal instability. Recommend immediate maintenance cycle. }
      }

      txt($h2) { Power Systems Summary }
      tbl(cols="2fr 1fr 1fr") {
        System, Output, Status;
        Solar Array Alpha, 500kW, Optimal;
        Solar Array Beta, 480kW, Optimal;
        RTG Backup, 120kW, Standby;
        Fusion Core, 2.1GW, Warning
      }
    }
  }

  // PAGE 6: BLUEPRINTS
  page {
    box(p=10mm) {
      txt($h2) { Habitat Module Alpha }
      txt($p) { Schematic layout of the primary habitat module showing central hub and four connecting pods. }
      sp(h=3mm) {}
      box(bg=#1e293b, p=8mm, border=1) {
        txt(color=white, bold, size=14, mb=5mm, ta=center) { HABITAT MODULE ALPHA — TOP VIEW }
        sp(h=3mm) {}
        cols(n=3, gap=3mm) {
          box(p=4mm, border=1, bg=#0f172a) {
            txt(color=#0ea5e9, bold, ta=center) { O2 GEN }
            txt(color=#94a3b8, size=8, ta=center) { Oxygen Generation }
          }
          box(p=8mm, border=1, bg=#0f172a) {
            txt(color=#0ea5e9, bold, size=16, ta=center) { HUB }
            txt(color=#94a3b8, size=8, ta=center) { Central Command }
          }
          box(p=4mm, border=1, bg=#0f172a) {
            txt(color=#0ea5e9, bold, ta=center) { H2O }
            txt(color=#94a3b8, size=8, ta=center) { Water Recycling }
          }
        }
        sp(h=3mm) {}
        cols(n=3, gap=3mm) {
          box(p=4mm, border=1, bg=#0f172a) {
            txt(color=#0ea5e9, bold, ta=center) { LAB }
            txt(color=#94a3b8, size=8, ta=center) { Science Laboratory }
          }
          box(p=4mm, border=1, bg=#0f172a) {
            txt(color=#94a3b8, size=8, ta=center) { Connecting Tunnel }
          }
          box(p=4mm, border=1, bg=#0f172a) {
            txt(color=#0ea5e9, bold, ta=center) { DORM }
            txt(color=#94a3b8, size=8, ta=center) { Living Quarters }
          }
        }
        sp(h=3mm) {}
        txt(color=#64748b, size=8, ta=center) { *Not to scale. Engineering use only. }
      }
    }
  }

  // PAGE 7: SUPPLY MANIFEST
  page {
    box(p=10mm) {
      txt($h2) { Supply Manifest — Food & Water }
      tbl(cols="1fr 3fr 1fr") {
        ID, ITEM, QTY (Tons);
        F-001, Dehydrated Protein, 50;
        F-002, Vitamin Supplements, 2;
        F-003, Hydroponic Seeds, 0.5;
        W-001, Filtered Water, 200;
        W-002, Recycling Filters, 5
      }

      sp(h=8mm) {}
      txt($h2) { Supply Manifest — Construction }
      tbl(cols="1fr 3fr 1fr") {
        ID, ITEM, QTY;
        C-101, Titanium Sheets, 500;
        C-102, Carbon Nanotubes, 200;
        C-103, Glass Panes (Rad-Proof), 50;
        C-104, Sealant Foam, 1000
      }

      sp(h=8mm) {}
      cols(between) {
        box(w=60%) {
          txt($h2) { Inventory QR }
          txt($mono) { Scan for digital manifest }
        }
        qr(data="ARES-INVENTORY-MANIFEST-A", w=25mm) {}
      }
    }
  }

  // PAGE 8: SUPPLY MANIFEST continued
  page {
    box(p=10mm) {
      txt($h2) { Supply Manifest — Electronics }
      tbl(cols="1fr 3fr 1fr") {
        ID, ITEM, QTY;
        E-201, Server Blades (AI), 20;
        E-202, Sensor Arrays, 500;
        E-203, Communication Dish, 2;
        E-204, Personal Tablets, 150
      }

      sp(h=8mm) {}
      txt($h2) { Supply Manifest — Medical }
      tbl(cols="1fr 3fr 1fr") {
        ID, ITEM, QTY;
        M-301, Trauma Kits, 100;
        M-302, Rad-X Injectors, 500;
        M-303, Surgical Bots, 5;
        M-304, Cryo-Stasis Fluid, 200L
      }

      sp(h=8mm) {}
      txt($h2) { Summary Totals }
      tbl(cols="2fr 1fr") {
        Category, Items;
        Food & Water, 257.5 tons;
        Construction, 1750 units;
        Electronics, 672 units;
        Medical, 805 units;
        TOTAL, 3484.5 units
      }
    }
  }

  // PAGE 9: PERSONNEL
  page {
    box(p=10mm) {
      txt($h2) { Command Staff }
      cols(n=2, gap=5mm) {
        box($sectionBox) {
          txt(bold) { CDR. Hassan Elkady }
          txt($mono) { Mission Commander }
        }
        box($sectionBox) {
          txt(bold) { XO. Sarah Vance }
          txt($mono) { Executive Officer }
        }
      }
      cols(n=2, gap=5mm) {
        box($sectionBox) {
          txt(bold) { Dr. Arinze Okafor }
          txt($mono) { Chief Scientist }
        }
        box($sectionBox) {
          txt(bold) { Eng. Liu Wei }
          txt($mono) { Chief Engineer }
        }
      }

      sp(h=5mm) {}
      txt($h2) { Engineering Team }
      tbl(cols="1fr 2fr 1fr") {
        ID, Name, Specialty;
        EN-01, John Doe, Propulsion;
        EN-02, Jane Smith, Structural;
        EN-03, Bob Jones, Electrical;
        EN-04, Alice Wong, Systems;
        EN-05, Charlie Brown, Maintenance;
        EN-06, David White, Robotics;
        EN-07, Eva Green, Life Support;
        EN-08, Frank Black, Networks
      }
    }
  }

  // PAGE 10: PERSONNEL continued
  page {
    box(p=10mm) {
      txt($h2) { Science Team }
      tbl(cols="1fr 2fr 1fr") {
        ID, Name, Specialty;
        SC-01, Mary Curie, Geology;
        SC-02, Isaac Newton, Physics;
        SC-03, Charles Darwin, Biology;
        SC-04, Albert Einstein, Theory;
        SC-05, Rosalind Franklin, DNA;
        SC-06, Carl Sagan, Astro;
        SC-07, Neil Tyson, Comm;
        SC-08, Stephen Hawking, Quantum
      }

      sp(h=8mm) {}
      txt($h2) { Security Detail }
      tbl(cols="1fr 2fr 1fr") {
        ID, Name, Rank;
        SE-01, Jack O Neill, Colonel;
        SE-02, Sam Carter, Major;
        SE-03, Tealc, Specialist;
        SE-04, Daniel Jackson, Consultant
      }
    }
  }

  // PAGE 11: RISK ASSESSMENT
  page {
    box(p=10mm) {
      txt($h1) { RISK ASSESSMENT }
      badge(bg=#dc2626, color=white) { CLASS A — TOP SECRET }
      sp(h=5mm) {}

      txt(bold, mb=3mm) { Threat Levels }
      bar(labels="Radiation,Meteor,Psychological,Equipment", data="80,20,60,40", label="Risk Score") {}

      sp(h=5mm) {}
      txt($p) { The primary risk to mission success remains long-term radiation exposure. Shielding integrity must be maintained above 90% at all times. Secondary concerns include psychological stress from prolonged isolation and equipment degradation in the harsh Martian environment. }

      sp(h=5mm) {}
      txt($h2) { Recent Incidents }
      box(p=4mm, bg=#fef2f2, border=1, mb=3mm) {
        txt(bold, color=#dc2626) { INCIDENT #9921 }
        txt($mono) { Airlock malfunction in Sector 4. Manual override required. No injuries. }
      }
      box(p=4mm, bg=#fffbeb, border=1, mb=3mm) {
        txt(bold, color=#d97706) { INCIDENT #9922 }
        txt($mono) { Power fluctuation in Hydroponics. 5% crop loss. }
      }
      box(p=4mm, bg=#f0fdf4, border=1, mb=3mm) {
        txt(bold, color=#16a34a) { INCIDENT #9923 }
        txt($mono) { Successful rover return. Sample A-92 processed. }
      }
    }
  }

  // PAGE 12: COMMS & FINANCE
  page {
    box(p=10mm) {
      txt($h2) { Earth Link Status }
      box(p=5mm, bg=#f0fdf4, border=1, mb=5mm) {
        txt(size=20, bold, color=#16a34a, ta=center) { CONNECTED }
      }
      tbl(cols="1fr 2fr") {
        Metric, Value;
        Signal Strength, 82%;
        Latency, 14m 32s;
        Bandwidth, 50 Mbps;
        Next Window, 4h 20m
      }

      sp(h=8mm) {}
      txt($h2) { Cost Analysis (Billions) }
      tbl(cols="2fr 1fr") {
        Department, Cost;
        Launch Logistics, $50B;
        R&D, $20B;
        Construction, $30B;
        Personnel, $10B;
        Contingency, $15B;
        TOTAL, $125B
      }
    }
  }

  // PAGE 13: FUTURE & SIGNOFF
  page {
    box(p=10mm) {
      txt($h2) { 5-Year Projection }
      txt(bold, mb=3mm) { Population Growth }
      bar(labels="Year 1,Year 2,Year 3,Year 4,Year 5", data="150,300,600,1200,2500", label="Colonists") {}

      sp(h=5mm) {}
      txt($p) { The projected exponential growth relies on successful completion of Phase 2 habitation modules and positive results from the terraforming initiative. Each year assumes a minimum of two supply runs from Earth. }
    }
  }

  // PAGE 14: FINAL SIGNOFF
  page {
    box(bg=#020617, p=20mm) {
      sp(h=20mm) {}
      box(center) {
        qr(data="APPROVED-BY-COMMAND-ARES-2026", w=35mm) {}
      }
      sp(h=8mm) {}
      txt(size=20, bold, color=white, ta=center) { MISSION APPROVED }
      sp(h=5mm) {}
      txt(size=12, color=#94a3b8, ta=center, italic) { Ad Astra Per Aspera }
      sp(h=15mm) {}
      hr(color=#334155) {}
      sp(h=5mm) {}
      txt(size=14, bold, color=#c2410c, ta=center) { HASSAN ELKADY }
      txt(size=10, color=white, ta=center) { MISSION COMMANDER }
      sp(h=20mm) {}
      txt(size=8, color=#475569, ta=center) { Generated by DARE Engine v12.0 }
    }
  }

}
