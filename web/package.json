{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages && find .vercel/output/static/_worker.js/ -type f -name \"*.js\" -exec sed -i \"s/from\\\"async_hooks\\\"/from\\\"node:async_hooks\\\"/g\" {} + && find .vercel/output/static/_worker.js/ -type f -name \"*.js\" -exec sed -i \"s/from \\\"async_hooks\\\"/from \\\"node:async_hooks\\\"/g\" {} +",
    "start": "next start",
    "lint": "eslint"
  },
  "browser": {
    "async_hooks": false
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "next": "^14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "^14.2.15",
    "tailwindcss": "^4"
  }
}
